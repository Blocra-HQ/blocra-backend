# Production Environment Variables for BlocRA Backend
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED - Must be set for production
# ============================================

# JWT Secret (CRITICAL - Generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Database (SQLite path - will be created if doesn't exist)
# For Render/cloud deployments, use /tmp for writable storage
# Local: sqlite:./data/blocra.db
# Render: sqlite:/tmp/blocra.db
DATABASE_URL=sqlite:/tmp/blocra.db

# ============================================
# OPTIONAL - Have sensible defaults
# ============================================

# JWT Token Expiration (in seconds)
# Default: 86400 (24 hours)
JWT_EXPIRATION=86400

# CORS origins (set to your frontend domain(s) in production)
# Examples:
#   - Single domain: https://yourdomain.com
#   - Multiple domains: https://yourdomain.com,https://app.yourdomain.com
#   - Allow all (development only): *
CORS_ORIGIN=*

# Rate Limiting
# Max requests per window
RATE_LIMIT_MAX_REQUESTS=1000
# Window duration in seconds (900 = 15 minutes)
RATE_LIMIT_WINDOW_SECS=900
# Set to 1 behind a reverse proxy (Render, nginx) so limits apply per real client IP
TRUST_PROXY=

# Logging Level
# Options: error, warn, info, debug, trace
# Production: info or warn
# Development: debug or trace
RUST_LOG=info

# ============================================
# OPTIONAL - Admin panel
# ============================================

# Password for POST /api/admin/login (at least 12 characters). Unset or
# shorter = admin login is disabled. Generate with: openssl rand -base64 24
ADMIN_PASSWORD=

# ============================================
# OPTIONAL - Chains
# ============================================

# Stellar (the default dashboard chain): mainnet or testnet. Horizon servers
# are built in (horizon.stellar.org, LOBSTR); STELLAR_HORIZON_URL is tried first.
STELLAR_NETWORK=mainnet
STELLAR_HORIZON_URL=

# Starknet: verified public RPCs are built in; STARKNET_RPC_URL is tried first.
STARKNET_RPC_URL=

# ============================================
# OPTIONAL - EVM transaction history
# ============================================

# Alchemy API key for POST /api/contract/transactions (Base, Ethereum,
# Arbitrum, Optimism, Polygon). Unset = that endpoint returns 503.
ALCHEMY_API_KEY=

# ============================================
# OPTIONAL - AI analyst (chat, reports, text-to-SQL)
# ============================================

# Any OpenAI-compatible chat-completions API. Unset = /api/ai/* answer 503.
# BlocRA's analyst runs on OpenAI's open-weight gpt-oss. AI_MODEL may be left
# empty: it defaults to gpt-oss:120b-cloud on Ollama, openai/gpt-oss-120b elsewhere.
#   Ollama cloud:    AI_BASE_URL=http://localhost:11434/v1   (run `ollama signin` once)
#   Ollama local:    AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=gpt-oss:20b   (16 GB+ RAM/VRAM)
#   vLLM:            AI_BASE_URL=http://gpu-host:8000/v1     AI_MODEL=openai/gpt-oss-120b
#   Groq (hosted):   AI_BASE_URL=https://api.groq.com/openai/v1   AI_API_KEY=<key>
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=
AI_API_KEY=
AI_REASONING_EFFORT=low
AI_TIMEOUT_SECS=120

# ============================================
# OPTIONAL - OAuth (only if using Google login)
# ============================================

# Google OAuth Credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# DEPLOYMENT CHECKLIST
# ============================================
# [ ] Generate strong JWT_SECRET (openssl rand -base64 32)
# [ ] Set CORS_ORIGIN to your frontend domain
# [ ] Adjust rate limits for your traffic
# [ ] Set RUST_LOG to 'info' or 'warn' for production
# [ ] Configure Google OAuth if needed
# [ ] Ensure DATABASE_URL path is writable
# [ ] Test all endpoints after deployment
# [ ] Monitor logs for errors
# [ ] Set up automated backups for database
